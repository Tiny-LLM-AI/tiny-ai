{
  "name": "@math-llm/core",
  "version": "3.0.0",
  "description": "A tiny Transformer written in plain TypeScript, with a hand-written forward and backward pass.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "train": "tsx src/cli/train.ts",
    "ask": "tsx src/cli/ask.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
